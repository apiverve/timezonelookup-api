    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "timezonelookup",
        "timezone lookup api",
        "timezone lookup",
        "city timezone",
        "utc offset lookup",
        "find local time by city"
    ],
    "homepage": "https://apiverve.com/marketplace/timezonelookup?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/timezonelookup",
        "source": "https://github.com/apiverve/timezonelookup-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Timezonelookup\\": "php/src/"
        }
    },
    "autoload-dev": {
